<Window x:Class="SocAutoTask.Desktop.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SocAutoTask.Desktop.Localization"
        xmlns:ctl="clr-namespace:SocAutoTask.Desktop.Controls"
        Title="{loc:T GuideTitle}"
        Width="560" Height="460" MinWidth="440" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">

    <!--
        Guia de configuracion (§6.10): un paso cada vez, con lo que hace, su estado (comprobado al
        volver a la ventana) y un boton que lo hace. Avanzar y volver, fijos abajo.
    -->
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StepCounter" Style="{StaticResource HintText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Style="{StaticResource GhostIconButton}" Tag="back" ToolTip="{loc:T GuideBack}"
                        AutomationProperties.Name="{loc:T GuideBack}" Click="OnBack" />
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Tag="next" ToolTip="{loc:T GuideNext}"
                        AutomationProperties.Name="{loc:T GuideNext}" Click="OnNext" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ctl:Icon x:Name="StepIcon" Width="28" Height="28" TextElement.Foreground="{DynamicResource Primary}" Margin="0,0,10,0" />
                        <TextBlock x:Name="StepTitle" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="StatusChip" CornerRadius="8" Padding="10,4" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <TextBlock x:Name="StatusLabel" FontWeight="SemiBold" Foreground="{DynamicResource OnPrimary}" />
                    </Border>
                    <TextBlock x:Name="StepText" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
                    <Button x:Name="ActionButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnAction" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
